# ----------------------------------------------------
# DATABASE & REDIS (Choose depending on how you run it)
# ----------------------------------------------------

# Option A: Backend running INSIDE Docker Compose
# DATABASE_URL=postgresql://<user>:<password>@db:5432/<database>
# REDIS_URL=redis://redis:6379

# Option B: Backend running NATIVELY on your host machine
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<database>
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------
# Security
# ----------------------------------------------------
JWT_SECRET=<generate-a-random-local-secret>
