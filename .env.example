# Database Configuration
POSTGRES_USER=examguard_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=examguard

# Backend / API
JWT_SECRET=your_jwt_secret_key_here
DATABASE_URL=postgresql://examguard_user:your_secure_password_here@localhost:5435/examguard
REDIS_HOST=localhost
REDIS_PORT=6380

# ML Worker Configuration
MODEL_NAME=yolov8s-pose.pt
VIDEO_PATH=input videos/04.CCTV Candidate Talking.mkv
CONFIDENCE_THRESHOLD=0.49

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
NEXT_PUBLIC_VIDEO_STREAM_URL=http://localhost:5000/video_feed

# Groq API (Explainability)
GROQ_API_KEY=your_groq_api_key_here
