# ----------------------------------------------------
# DATABASE & REDIS (ML Worker runs NATIVELY on the host)
# ----------------------------------------------------
# Because this worker is intentionally NOT dockerized yet, it must connect 
# to the Docker databases via their published localhost host ports.
# Do NOT use @db:5432 or redis://redis:6379 here.

DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<database>
REDIS_URL=redis://localhost:6379
