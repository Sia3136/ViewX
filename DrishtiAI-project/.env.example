# Database Configuration
POSTGRES_USER=examguard_user
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=examguard

# Backend / API
JWT_SECRET=your_secure_jwt_secret_here
# Note: From inside Docker, DATABASE_URL should use host 'db', but for native worker it should be 'localhost'
DATABASE_URL=postgresql://examguard_user:supersecretpassword@localhost:5432/examguard
REDIS_HOST=localhost
REDIS_PORT=6379

# ML Worker Configuration
MODEL_NAME=yolov8s-pose.pt
VIDEO_PATH=input videos/04.CCTV Candidate Talking.mkv
CONFIDENCE_THRESHOLD=0.49

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_VIDEO_STREAM_URL=http://localhost:5000/video_feed
